<UserControl x:Class="Photobooth.UI.ScreenTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource CanvasBrush}"
        MinWidth="920"
        MinHeight="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkPalette.xaml" />
                <!-- Kiosk-prefixed keys only (KioskCanvasBrush, KioskAccentBrush,
                     KioskModeTile, ...), no collision with DarkPalette's own
                     unprefixed tokens above. Merged so the canvas chrome mockup
                     below (WelcomeChromeLayer/CaptureChromeLayer/SharingChromeLayer)
                     renders with the exact same brushes/styles KioskWindow itself
                     uses, instead of a second hand-typed copy that can drift. -->
                <ResourceDictionary Source="Themes/KioskDark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- DarkPalette.xaml only carries the 5 shared tokens (Canvas/Ink/
                 Muted/Accent/Line); FieldBrush/OnAccentBrush are this window's
                 own, same values AdminWindow already established so inputs and
                 accent-text read identically across both windows. -->
            <SolidColorBrush x:Key="FieldBrush" Color="#1F2023" />
            <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0C0D" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />

            <Style x:Key="EditorSectionHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Margin" Value="0,16,0,6" />
            </Style>
            <Style x:Key="EditorLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Margin" Value="0,4,0,2" />
            </Style>
            <!-- Breadcrumb-style link to the separate Print Layout editor
                 window (PrintTemplateEditorWindow), same "Print Layout >" nav
                 dslrBooth's own Screen Editor header carries. Clicking it
                 closes this dialog and asks AdminWindow to open that other
                 editor next (see PrintLayoutLink_MouseLeftButtonDown /
                 OpenPrintLayoutRequested), since the two are separate windows
                 rather than tabs of one page. -->
            <Style x:Key="BreadcrumbLink" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- ===================== Icon geometries ===================== -->
            <!-- Small line-icon set for the tool rail, alignment grid, tab
                 headers and the new pose-thumbnail dock picker, since this window
                 had no icons at all before, everything was text buttons. -->
            <Geometry x:Key="IconTextTool">M5,5 L19,5 M12,5 L12,19</Geometry>
            <GeometryGroup x:Key="IconImageTool">
                <RectangleGeometry Rect="3.5,4.5,17,15" />
                <PathGeometry Figures="M4,17 L9.5,11.5 L14,16 L16.5,13.5 L20,17" />
                <EllipseGeometry Center="9,10" RadiusX="1.6" RadiusY="1.6" />
            </GeometryGroup>
            <RectangleGeometry x:Key="IconShapeTool" Rect="4,4,16,16" RadiusX="3" RadiusY="3" />

            <Geometry x:Key="IconAlignLeft">M4,6 L20,6 M4,12 L14,12 M4,18 L17,18</Geometry>
            <Geometry x:Key="IconAlignCenterH">M4,6 L20,6 M7,12 L17,12 M5.5,18 L18.5,18</Geometry>
            <Geometry x:Key="IconAlignRight">M4,6 L20,6 M10,12 L20,12 M7,18 L20,18</Geometry>
            <Geometry x:Key="IconAlignTop">M6,4 L18,4 M8,8 L16,8 M9,12 L15,12</Geometry>
            <Geometry x:Key="IconAlignCenterV">M4,12 L20,12 M8,8 L16,8 M9,16 L15,16</Geometry>
            <Geometry x:Key="IconAlignBottom">M6,20 L18,20 M8,16 L16,16 M9,12 L15,12</Geometry>

            <GeometryGroup x:Key="IconTrash">
                <PathGeometry Figures="M5,7 L19,7" />
                <PathGeometry Figures="M9,7 L9,5.5 A1.5,1.5 0 0 1 10.5,4 L13.5,4 A1.5,1.5 0 0 1 15,5.5 L15,7" />
                <PathGeometry Figures="M7,7 L8,19.2 A1.8,1.8 0 0 0 9.8,21 L14.2,21 A1.8,1.8 0 0 0 16,19.2 L17,7" />
            </GeometryGroup>

            <!-- Pose-thumbnail dock icons: one shared outer frame (stroked)
                 plus a per-direction inner band (filled), composited as two
                 Paths at each usage site since a single Geometry can't mix a
                 stroke-only and a fill-only pass. -->
            <RectangleGeometry x:Key="IconFrameRect" Rect="4,4,16,16" RadiusX="2.5" RadiusY="2.5" />
            <RectangleGeometry x:Key="IconDockBandTop" Rect="4,4,16,5" />
            <RectangleGeometry x:Key="IconDockBandBottom" Rect="4,15,16,5" />
            <RectangleGeometry x:Key="IconDockBandLeft" Rect="4,4,5,16" />
            <RectangleGeometry x:Key="IconDockBandRight" Rect="15,4,5,16" />

            <Geometry x:Key="IconWelcome">M4,11 L12,5 L20,11 M6,10 L6,19 L11,19 L11,14 L13,14 L13,19 L18,19 L18,10</Geometry>
            <GeometryGroup x:Key="IconCapture">
                <PathGeometry Figures="M4,8.5 L7,8.5 L8.3,6.5 L15.7,6.5 L17,8.5 L20,8.5 L20,19 L4,19 Z" />
                <EllipseGeometry Center="12,13.5" RadiusX="3.4" RadiusY="3.4" />
            </GeometryGroup>
            <GeometryGroup x:Key="IconSharing">
                <EllipseGeometry Center="6,12" RadiusX="2.4" RadiusY="2.4" />
                <EllipseGeometry Center="18,6" RadiusX="2.4" RadiusY="2.4" />
                <EllipseGeometry Center="18,18" RadiusX="2.4" RadiusY="2.4" />
                <PathGeometry Figures="M8.2,10.8 L15.8,7 M8.2,13.2 L15.8,17" />
            </GeometryGroup>

            <!-- ===================== Buttons ===================== -->
            <!-- Neutral field-colored pill: the implicit (unkeyed) style, so
                 Cancel/Browse/etc. pick it up with no per-button Style
                 reference needed. -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource FieldBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Solid accent pill, for the one primary action (Save). -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Danger-tinted ghost button, for Delete selected. -->
            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            </Style>

            <!-- Icon-only rail button (Text/Image/Shape): transparent until
                 hovered, ToolTip carries the label since there's no room for
                 text next to the icon. -->
            <Style x:Key="IconRailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Small icon-only action button, for the alignment grid. -->
            <Style x:Key="IconActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            </Style>

            <!-- ===================== Inputs ===================== -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource FieldBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Toggle-switch CheckBox (On/Off pill), for the real Welcome/
                 Capture screen-chrome toggles, implicit so BoothIconsEnabled/
                 ShowLiveView/MirrorLiveView pick it up automatically. -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Track" Width="38" Height="21" CornerRadius="11"
                                        Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <Border x:Name="Thumb" Width="15" Height="15" CornerRadius="8"
                                            Background="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                                </Border>
                                <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Thumb" Property="Background" Value="{StaticResource OnAccentBrush}" />
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Icon-toggle variant, for Bold (a real on/off text property,
                 just not a "chrome enabled" switch, so a small pressed-look
                 pill reads better than the track-and-thumb switch above). -->
            <Style x:Key="IconToggleCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bd" Width="34" Height="30" CornerRadius="6"
                                    Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmented pill chip RadioButton, used for both Live view
                 rotation (text content) and the new Pose thumbnails dock
                 picker (icon content); same chip AdminWindow's mode/layout
                 pickers already use. -->
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                    Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Flat accent-thumb Slider (Font size). -->
            <Style TargetType="Slider">
                <Setter Property="Height" Value="24" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="4" Background="{StaticResource LineBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="Slider.DecreaseLarge" Background="Transparent" BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="4" Background="{StaticResource AccentBrush}" CornerRadius="2" VerticalAlignment="Center" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="16" Height="16">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Ellipse Fill="{StaticResource AccentBrush}" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== Dropdowns ===================== -->
            <!-- Stretch live view / Sharing icons location: default ComboBox
                 chrome paints its own light popup background regardless of
                 CanvasBrush, same unreadable-on-dark problem TabControl had
                 above, so this gets the same field-colored retemplate. -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource FieldBrush}" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                                   ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                   Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="200">
                                        <ScrollViewer>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===================== Layers list ===================== -->
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="{StaticResource FieldBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="6,6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#282A2D" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One row per element: a small type-icon chip (its own color
                 doesn't need to flip on selection since the row background
                 already carries that) plus the element's display name. -->
            <DataTemplate x:Key="LayerRowTemplate">
                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource CanvasBrush}" Margin="0,0,8,0">
                        <Path Data="{Binding IconData}" Stretch="Uniform" Width="12" Height="12"
                              Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="12.5" Foreground="{StaticResource InkBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>

            <!-- ===================== Tabs ===================== -->
            <!-- Both TabControls on this window (screen selector up top,
                 DESIGN/SETTINGS side panel) were left on the default WPF/OS
                 tab chrome, which paints its own light background regardless
                 of CanvasBrush, so the InkBrush (near-white) header/label
                 text landed on a near-white tab background and was
                 unreadable. Fully re-templating both removes that chrome
                 and paints tab headers/content with this window's own dark
                 palette instead. -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                    Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TabPanel Grid.Row="0" IsItemsHost="True" Background="Transparent" Margin="0,0,0,10" />
                                <Border Grid.Row="1" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <ContentPresenter ContentSource="SelectedContent" Margin="12" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Screen switcher (Welcome/Capture/Sharing): a filled accent
                 pill on the active screen instead of the underline above,
                 since it's the primary navigation for this whole window, not a
                 secondary in-panel tab pair, so it reads as the bolder
                 control of the two tab styles here. -->
            <Style x:Key="ScreenSwitchTabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}" Margin="2,0">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ScreenTabControl has no per-tab content, only headers; it
                 just swaps which screen ElementsCanvas below is showing. The
                 default TabControl style above renders a content Border
                 regardless, which would leave an empty rounded box under the
                 headers here, so this selector gets a headers-only template,
                 plus a Border of its own to house the pill row. -->
            <Style x:Key="SegmentedTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="3">
                                <TabPanel IsItemsHost="True" Background="Transparent" HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- ================= Top bar: title + screen switcher ================= -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="SCREEN LAYOUT EDITOR" FontSize="12.5" FontWeight="SemiBold" FontFamily="Segoe UI"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="EditingSubtitleText" Text="Editing the Welcome screen" FontSize="11.5" FontFamily="Segoe UI"
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <TextBlock Grid.Column="2" Style="{StaticResource BreadcrumbLink}" HorizontalAlignment="Right" VerticalAlignment="Center"
                       MouseLeftButtonDown="PrintLayoutLink_MouseLeftButtonDown">
                <Run Text="Print Layout" />
                <Run Text=" &gt;" />
            </TextBlock>

            <!-- One tab per guest-facing screen (see ScreenTemplateScreen);
                 switching tabs swaps which screen's working element list
                 ElementsCanvas below is showing/editing, same reusable-canvas
                 approach the ScreenTemplateEditorWindow code comment
                 explains, rather than three separate canvases. -->
            <TabControl x:Name="ScreenTabControl" Grid.Column="1" Style="{StaticResource SegmentedTabControl}"
                        SelectionChanged="ScreenTabControl_SelectionChanged" VerticalAlignment="Center">
                <TabItem Tag="Welcome" Style="{StaticResource ScreenSwitchTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconWelcome}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Welcome" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem Tag="Capture" Style="{StaticResource ScreenSwitchTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCapture}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Capture" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
                <TabItem Tag="Sharing" Style="{StaticResource ScreenSwitchTabItem}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSharing}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,6,0"
                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Sharing" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                </TabItem>
            </TabControl>

            <Border Grid.Column="2" />
        </Grid>

        <!-- ================= Left tool rail ================= -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <Button x:Name="AddTextButton" Style="{StaticResource IconRailButton}" ToolTip="Add text" Click="AddTextButton_Click" Margin="0,0,0,4">
                <Path Data="{StaticResource IconTextTool}" Stretch="Uniform" Width="17" Height="17"
                      Stroke="{StaticResource InkBrush}" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Button x:Name="AddImageButton" Style="{StaticResource IconRailButton}" ToolTip="Add image" Click="AddImageButton_Click" Margin="0,0,0,4">
                <Path Data="{StaticResource IconImageTool}" Stretch="Uniform" Width="17" Height="17"
                      Stroke="{StaticResource InkBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Button x:Name="AddShapeButton" Style="{StaticResource IconRailButton}" ToolTip="Add shape" Click="AddShapeButton_Click">
                <Path Data="{StaticResource IconShapeTool}" Stretch="Uniform" Width="17" Height="17"
                      Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" />
            </Button>
        </StackPanel>

        <!-- ElementsCanvas holds only the admin-placed text/image/shape overlays
             (unchanged from before); everything else in this Grid is a
             non-interactive, screen-accurate mockup of KioskWindow's own real
             chrome (background, mode tiles, live-view frame, share buttons)
             so the canvas stops being a dead off-white box and actually shows
             what guests see on each of the three tabs. Exactly one of the
             three ChromeLayer Grids is visible at a time, matching
             _activeScreen (see LoadActiveScreen/UpdateScreenChrome); they sit
             behind ElementsCanvas so dragging/resizing an overlay element is
             unaffected. IsHitTestVisible="False" throughout since none of
             this is ever clicked. -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Background="{StaticResource KioskCanvasBrush}">

                <!-- ===================== WELCOME CHROME MOCKUP =====================
                     Mirrors KioskWindow's IdleScreen: background, centered
                     logo/event name, "touch to begin" pill, and the four
                     capture-mode tiles (unconditional there too, so no
                     visibility binding needed here). -->
                <Grid x:Name="WelcomeChromeLayer" Visibility="Collapsed">
                    <Border x:Name="WelcomeBackgroundFill" Background="{StaticResource KioskCanvasBrush}" IsHitTestVisible="False" />
                    <Image x:Name="WelcomeBackgroundImageElement" Stretch="UniformToFill" IsHitTestVisible="False" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image x:Name="WelcomeBrandingLogo" MaxHeight="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock x:Name="WelcomeBrandingEventName" Style="{StaticResource KioskH1}" FontSize="20" />
                        <Border Background="{StaticResource KioskAccentBrush}" CornerRadius="8" Padding="16,7" Margin="0,14,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="TOUCH SCREEN TO BEGIN" FontFamily="{StaticResource KioskFont}" FontSize="10"
                                       FontWeight="SemiBold" Foreground="{StaticResource KioskOnAccentBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Booth Icons group - free-positioned/toggleable/row-or-
                         column, see LoadWelcomeIconsGroup and IconGroup_Mouse*
                         in the code-behind. A dedicated Canvas sized 1:1 with
                         ElementsCanvas (both stretch to the same parent Grid,
                         which ElementsCanvas's own explicit Width/Height forces
                         to CanvasWidth x CanvasHeight) so PositionXPercent/
                         YPercent convert the same way ScreenTemplateElement's
                         XPercent/YPercent already do. Only WelcomeIconsGroupBorder
                         itself is hit-test visible - every tile inside is
                         IsHitTestVisible="False" so a click anywhere on the
                         group always drags the whole thing rather than a Button
                         swallowing it (these tiles aren't clickable in the
                         editor anyway; only the real KioskWindow's tiles are). -->
                    <Canvas x:Name="WelcomeIconsPositionCanvas">
                        <Border x:Name="WelcomeIconsGroupBorder" Cursor="SizeAll" Background="Transparent"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0"
                                MouseLeftButtonDown="IconGroup_MouseLeftButtonDown"
                                MouseMove="IconGroup_MouseMove"
                                MouseLeftButtonUp="IconGroup_MouseLeftButtonUp"
                                Tag="Welcome">
                            <StackPanel x:Name="WelcomeIconsStackPanel" Orientation="Horizontal" IsHitTestVisible="False">
                                <Button x:Name="WelcomeIconPhotoTile" Style="{StaticResource KioskModeTile}" Width="66" Height="54" Margin="3" IsHitTestVisible="False">
                                    <StackPanel>
                                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource KioskAccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="WelcomeIconPhotoLabel" Text="PHOTO" FontFamily="{StaticResource KioskFont}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource KioskInkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WelcomeIconGifTile" Style="{StaticResource KioskModeTile}" Width="66" Height="54" Margin="3" IsHitTestVisible="False">
                                    <StackPanel>
                                        <TextBlock Text="&#xE786;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource KioskAccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="WelcomeIconGifLabel" Text="GIF" FontFamily="{StaticResource KioskFont}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource KioskInkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WelcomeIconBoomerangTile" Style="{StaticResource KioskModeTile}" Width="66" Height="54" Margin="3" IsHitTestVisible="False">
                                    <StackPanel>
                                        <TextBlock Text="&#xE8EE;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource KioskAccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="WelcomeIconBoomerangLabel" Text="BOOMERANG" FontFamily="{StaticResource KioskFont}" FontSize="6.5" FontWeight="SemiBold" Foreground="{StaticResource KioskInkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WelcomeIconVideoTile" Style="{StaticResource KioskModeTile}" Width="66" Height="54" Margin="3" IsHitTestVisible="False">
                                    <StackPanel>
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource KioskAccentBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="WelcomeIconVideoLabel" Text="VIDEO" FontFamily="{StaticResource KioskFont}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource KioskInkBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>

                <!-- ===================== CAPTURE CHROME MOCKUP =====================
                     Mirrors KioskWindow's CountdownScreen/CaptureScreen: a
                     stand-in for the live camera feed (unavailable in the
                     editor), the accent preview frame, "GET READY" + a sample
                     countdown digit, and the Cancel pill. -->
                <Grid x:Name="CaptureChromeLayer" Visibility="Collapsed">
                    <Border x:Name="CaptureBackgroundFill" Background="{StaticResource KioskCanvasBrush}" IsHitTestVisible="False" />
                    <Image x:Name="CaptureBackgroundImageElement" Stretch="UniformToFill" IsHitTestVisible="False" />

                    <Border Background="{StaticResource KioskSurfaceBrush}" Margin="50" IsHitTestVisible="False">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                   Foreground="{StaticResource KioskLineBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Margin="26" BorderBrush="{StaticResource KioskAccentBrush}" BorderThickness="2" CornerRadius="10" Opacity="0.5" IsHitTestVisible="False" />

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="GET READY" FontFamily="{StaticResource KioskFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource KioskInkBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="CaptureChromeCountdownText" Text="3" FontFamily="{StaticResource KioskFont}" FontSize="56" FontWeight="Light"
                                   HorizontalAlignment="Center" Margin="0,-6,0,0" />
                    </StackPanel>

                    <!-- Cancel button - free-positioned/toggleable, same
                         IconGroup_Mouse* drag handlers as the Welcome/Sharing
                         icon groups, but a single-item group (no Layout/
                         Alignment controls - see CaptureCancelButtonPositionXPercent's
                         doc comment on ScreenSettings). -->
                    <Canvas x:Name="CaptureCancelButtonPositionCanvas">
                        <Border x:Name="CaptureCancelButtonGroupBorder" Cursor="SizeAll" Tag="Capture" Background="Transparent"
                                MouseLeftButtonDown="IconGroup_MouseLeftButtonDown"
                                MouseMove="IconGroup_MouseMove"
                                MouseLeftButtonUp="IconGroup_MouseLeftButtonUp">
                            <Border x:Name="CaptureChromeCancelPill" BorderBrush="{StaticResource KioskLineBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,6" IsHitTestVisible="False">
                                <TextBlock Text="CANCEL" FontFamily="{StaticResource KioskFont}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource KioskMutedBrush}" />
                            </Border>
                        </Border>
                    </Canvas>

                    <!-- Thumbnail Strip preview: position/opacity/active-border/
                         placeholder-numbers all driven live from the Thumbnail
                         Strip Settings section (see LoadPoseStripGroup), edge-docked
                         same as the real KioskWindow strip (not free-drag like the
                         Cancel button/icon groups above). Slot 2 shown "active" to
                         demo the border highlight against the sample countdown "2". -->
                    <Border x:Name="CaptureChromePoseStrip" CornerRadius="8" Margin="14" Padding="6" IsHitTestVisible="False">
                        <UniformGrid x:Name="CaptureChromePoseStripItems" Rows="1" Columns="4">
                            <Border x:Name="CaptureChromePoseSlot1" Width="26" Height="26" Margin="3" CornerRadius="4" Background="#33FFFFFF">
                                <TextBlock x:Name="CaptureChromePoseNumber1" Text="1" FontFamily="{StaticResource KioskFont}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource KioskMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="CaptureChromePoseSlot2" Width="26" Height="26" Margin="3" CornerRadius="4" Background="#33FFFFFF">
                                <TextBlock x:Name="CaptureChromePoseNumber2" Text="2" FontFamily="{StaticResource KioskFont}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource KioskMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="CaptureChromePoseSlot3" Width="26" Height="26" Margin="3" CornerRadius="4" Background="#33FFFFFF">
                                <TextBlock x:Name="CaptureChromePoseNumber3" Text="3" FontFamily="{StaticResource KioskFont}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource KioskMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="CaptureChromePoseSlot4" Width="26" Height="26" Margin="3" CornerRadius="4" Background="#33FFFFFF">
                                <TextBlock x:Name="CaptureChromePoseNumber4" Text="4" FontFamily="{StaticResource KioskFont}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource KioskMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </UniformGrid>
                    </Border>
                </Grid>

                <!-- ===================== SHARING CHROME MOCKUP =====================
                     Mirrors KioskWindow's ReviewScreen: a white "printed
                     photo" card on the left, QR/Email/SMS/Print/Retake/Done
                     on the right, visibility for each wired the same way
                     KioskViewModel drives the real ones (see
                     ScreenTemplateEditorWindow.xaml.cs's UpdateScreenChrome). -->
                <Grid x:Name="SharingChromeLayer" Visibility="Collapsed">
                    <Border x:Name="SharingBackgroundFill" Background="{StaticResource KioskCanvasBrush}" IsHitTestVisible="False" />
                    <Image x:Name="SharingBackgroundImageElement" Stretch="UniformToFill" IsHitTestVisible="False" />

                    <Grid Margin="36,26,36,18" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Width="150" Height="190"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Your Photo" FontFamily="Segoe UI" FontSize="11" Foreground="#6E706F"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- QR/Email/SMS/Print pulled out of this static
                             StackPanel into their own free-positioned group
                             below (SharingIconsPositionCanvas) - "Your photo
                             is ready" and Retake/Done stay here since they're
                             not part of the icon row this editor now lets an
                             admin drag/reorder/toggle. -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock Text="Your photo is ready" FontFamily="{StaticResource KioskFont}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource KioskInkBrush}" TextWrapping="Wrap" />
                            <Border x:Name="SharingChromeRetakePill" BorderBrush="{StaticResource KioskLineBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,6" Margin="0,14,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="RETAKE" FontFamily="{StaticResource KioskFont}" FontSize="9" Foreground="{StaticResource KioskMutedBrush}" />
                            </Border>
                            <Border x:Name="SharingChromeDonePill" BorderBrush="{StaticResource KioskLineBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <TextBlock Text="I'M DONE" FontFamily="{StaticResource KioskFont}" FontSize="9" Foreground="{StaticResource KioskMutedBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Sharing icon row (QR/Email/SMS/Print) - free-
                         positioned/toggleable/row-or-column, same pattern as
                         the Welcome Booth Icons group above (see
                         LoadSharingIconsGroup/IconGroup_Mouse* in the
                         code-behind). -->
                    <Canvas x:Name="SharingIconsPositionCanvas">
                        <Border x:Name="SharingIconsGroupBorder" Cursor="SizeAll" Background="Transparent"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0"
                                MouseLeftButtonDown="IconGroup_MouseLeftButtonDown"
                                MouseMove="IconGroup_MouseMove"
                                MouseLeftButtonUp="IconGroup_MouseLeftButtonUp"
                                Tag="Sharing">
                            <StackPanel x:Name="SharingIconsStackPanel" IsHitTestVisible="False">
                                <StackPanel x:Name="SharingChromeQrGroup" Margin="4">
                                    <Border x:Name="SharingChromeQrBox" Background="White" CornerRadius="6" Width="56" Height="56" HorizontalAlignment="Left">
                                        <TextBlock Text="QR" FontFamily="Segoe UI" FontSize="10" Foreground="#202124"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="SharingChromeQrLabel" Text="Scan to download" FontFamily="{StaticResource KioskFont}"
                                               FontSize="8" Foreground="{StaticResource KioskInkBrush}" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel x:Name="SharingChromeEmailRow" Margin="4">
                                    <TextBlock x:Name="SharingChromeEmailLabel" Text="EMAIL IT TO ME" FontFamily="{StaticResource KioskFont}"
                                               FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource KioskMutedBrush}" />
                                    <Border Background="{StaticResource KioskFieldBrush}" BorderBrush="{StaticResource KioskLineBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,2,0,0">
                                        <TextBlock Text="you@example.com" FontFamily="{StaticResource KioskFont}" FontSize="8" Foreground="{StaticResource KioskMutedBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel x:Name="SharingChromeSmsRow" Margin="4">
                                    <TextBlock x:Name="SharingChromeSmsLabel" Text="TEXT IT TO ME" FontFamily="{StaticResource KioskFont}"
                                               FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource KioskMutedBrush}" />
                                    <Border Background="{StaticResource KioskFieldBrush}" BorderBrush="{StaticResource KioskLineBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,2,0,0">
                                        <TextBlock Text="09xx xxx xxxx" FontFamily="{StaticResource KioskFont}" FontSize="8" Foreground="{StaticResource KioskMutedBrush}" />
                                    </Border>
                                </StackPanel>

                                <Border x:Name="SharingChromePrintPill" Background="{StaticResource KioskAccentBrush}" CornerRadius="6"
                                        Padding="12,6" Margin="4" HorizontalAlignment="Left">
                                    <TextBlock Text="PRINT" FontFamily="{StaticResource KioskFont}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource KioskOnAccentBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>

                <!-- Small top-center brand bar, matching KioskWindow's own
                     CHROME: BRAND BAR block shown on Countdown/Capture/
                     Processing/Review, one shared element rather than one
                     per chrome layer, toggled by UpdateBrandingLayer the same
                     "visible unless Welcome" way it always has been. -->
                <StackPanel x:Name="BrandBarBrandingLayer" IsHitTestVisible="False" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Visibility="Collapsed">
                    <Image x:Name="BrandBarLogo" Height="14" Margin="0,0,6,0" Stretch="Uniform" />
                    <TextBlock x:Name="BrandBarEventName" FontFamily="{StaticResource KioskFont}" FontSize="9" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskAccentBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- No Background here (each element container sets its own,
                     see AddVisualForElement) - a null Background lets clicks
                     on canvas area with no admin-placed element fall through
                     to the icon groups underneath (WelcomeIconsGroupBorder/
                     SharingIconsGroupBorder/CaptureCancelButtonGroupBorder in
                     the chrome layers below) instead of this topmost, full-
                     bleed Canvas swallowing every hit first. -->
                <Canvas x:Name="ElementsCanvas" />
            </Grid>
        </Border>

        <!-- DESIGN/SETTINGS split, matching dslrBooth's own Screen Editor side
             panel (see BUILD_PLAN.md/the reference screenshots): DESIGN holds
             everything about the elements on the active screen's canvas,
             SETTINGS holds the screen-chrome toggles that used to have no
             editable UI anywhere in this build (see ScreenSettings and
             AdminWindow's own "ScreenSettings has no editable UI" comment,
             now closed by this tab). -->
        <TabControl Grid.Row="1" Grid.Column="2" Margin="0">
            <TabItem Header="DESIGN">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,-6,0,0">
                <StackPanel Margin="0,4,4,0">
                    <TextBlock x:Name="LayersHeaderText" Text="Layers" Style="{StaticResource EditorSectionHeader}" Margin="0,0,0,6" />
                    <ListBox x:Name="LayerListBox" Height="90" ItemTemplate="{StaticResource LayerRowTemplate}" SelectionChanged="LayerListBox_SelectionChanged" />

                    <!-- Aligns the selected element against the canvas bounds
                         (left/center/right, top/middle/bottom): the single-
                         element subset of dslrBooth's own Alignment grid; that
                         reference also aligns multi-selections relative to each
                         other, which this editor's single-selection model
                         doesn't support. -->
                    <TextBlock Text="Alignment" Style="{StaticResource EditorSectionHeader}" />
                    <UniformGrid Rows="2" Columns="3">
                        <Button x:Name="AlignLeftButton" Style="{StaticResource IconActionButton}" Margin="0,0,4,4" ToolTip="Align left" Click="AlignButton_Click" Tag="Left">
                            <Path Data="{StaticResource IconAlignLeft}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="AlignCenterButton" Style="{StaticResource IconActionButton}" Margin="0,0,4,4" ToolTip="Center horizontally" Click="AlignButton_Click" Tag="CenterHorizontal">
                            <Path Data="{StaticResource IconAlignCenterH}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="AlignRightButton" Style="{StaticResource IconActionButton}" Margin="0,0,0,4" ToolTip="Align right" Click="AlignButton_Click" Tag="Right">
                            <Path Data="{StaticResource IconAlignRight}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="AlignTopButton" Style="{StaticResource IconActionButton}" Margin="0,0,4,0" ToolTip="Align top" Click="AlignButton_Click" Tag="Top">
                            <Path Data="{StaticResource IconAlignTop}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="AlignMiddleButton" Style="{StaticResource IconActionButton}" Margin="0,0,4,0" ToolTip="Center vertically" Click="AlignButton_Click" Tag="CenterVertical">
                            <Path Data="{StaticResource IconAlignCenterV}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button x:Name="AlignBottomButton" Style="{StaticResource IconActionButton}" ToolTip="Align bottom" Click="AlignButton_Click" Tag="Bottom">
                            <Path Data="{StaticResource IconAlignBottom}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </UniformGrid>

                    <TextBlock x:Name="SelectedElementHeaderText" Text="Selected element" Style="{StaticResource EditorSectionHeader}" />
                    <TextBlock x:Name="NoSelectionText" Text="Tap an element on the canvas or a layer to edit it." Style="{StaticResource EditorLabel}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                    <StackPanel x:Name="TextPropertiesPanel" Visibility="Collapsed">
                        <TextBlock Text="Text" Style="{StaticResource EditorLabel}" />
                        <TextBox x:Name="ElementTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" TextChanged="ElementTextBox_TextChanged" />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Font size" Style="{StaticResource EditorLabel}" Margin="0" />
                                <Slider x:Name="FontSizeSlider" Minimum="0.02" Maximum="0.15" ValueChanged="FontSizeSlider_ValueChanged" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="BoldCheckBox" Grid.Column="1" Style="{StaticResource IconToggleCheckBox}" Content="B" FontWeight="Bold"
                                      VerticalAlignment="Bottom" Margin="10,0,0,0" ToolTip="Bold" Click="BoldCheckBox_Click" />
                        </Grid>

                        <TextBlock Text="Color" Style="{StaticResource EditorLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TextColorSwatch" Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0" />
                            <TextBox x:Name="ElementColorBox" Grid.Column="1" TextChanged="ElementColorBox_TextChanged" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ImagePropertiesPanel" Visibility="Collapsed">
                        <TextBlock Text="Image" Style="{StaticResource EditorLabel}" />
                        <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="7" Height="80" Margin="0,2,0,8">
                            <Image x:Name="SelectedImagePreview" Stretch="Uniform" Margin="6" />
                        </Border>
                        <Button x:Name="ChangeImageButton" Content="Browse..." Padding="14,7" HorizontalAlignment="Left" Click="ChangeImageButton_Click" />
                    </StackPanel>

                    <StackPanel x:Name="ShapePropertiesPanel" Visibility="Collapsed">
                        <TextBlock Text="Fill color" Style="{StaticResource EditorLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ShapeColorSwatch" Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0" />
                            <TextBox x:Name="ShapeColorBox" Grid.Column="1" TextChanged="ElementColorBox_TextChanged" />
                        </Grid>
                    </StackPanel>

                    <Button x:Name="DeleteSelectedButton" Style="{StaticResource DangerButton}" Padding="10,7" Margin="0,18,0,0"
                            HorizontalAlignment="Left" IsEnabled="False" Click="DeleteSelectedButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash}" Stretch="Uniform" Width="13" Height="13" Margin="0,0,7,0"
                                  Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Text="Delete selected" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SETTINGS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,-6,0,0">
                <StackPanel Margin="0,4,4,0">
                    <TextBlock x:Name="SettingsHeaderText" Text="Settings · Welcome" Style="{StaticResource EditorSectionHeader}" Margin="0,0,0,6" />

                    <!-- Only ever the settings that actually apply to the
                         active screen (BoothIconsEnabled only matters on
                         Welcome; ShowLiveView/MirrorLiveView/LiveViewRotation/
                         PoseStripPosition only matter on Capture), same
                         split dslrBooth uses instead of one flat panel shown
                         for every screen. -->
                    <StackPanel x:Name="WelcomeSettingsPanel">
                        <TextBlock Text="Background" Style="{StaticResource EditorSectionHeader}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="WelcomeBackgroundColorSwatch" Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0" />
                            <TextBox x:Name="WelcomeBackgroundColorBox" Grid.Column="1" TextChanged="WelcomeBackgroundColorBox_TextChanged" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WelcomeBackgroundImageNameText" Grid.Column="0" Text="No image selected." Style="{StaticResource EditorLabel}"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0" />
                            <Button x:Name="ChooseWelcomeBackgroundImageButton" Grid.Column="1" Content="Choose..." Padding="12,6" Margin="8,0,0,0" Click="ChooseWelcomeBackgroundImageButton_Click" />
                        </Grid>

                        <CheckBox x:Name="BoothIconsEnabledCheckBox" Content="Booth icons" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Hides the whole Photo/GIF/Boomerang/Video group when off." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10" />

                        <CheckBox x:Name="BoothIconLabelsEnabledCheckBox" Content="Booth icon labels" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Display text labels below icons." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <!-- Per-icon visibility - each Photo/GIF/Boomerang/
                             Video tile can be hidden individually, on top of
                             BoothIconsEnabled hiding the whole group above.
                             Drag the group itself on the DESIGN tab's canvas
                             to reposition it; Layout/Alignment below control
                             row-vs-column and how the tiles pack. -->
                        <TextBlock Text="Icons shown" Style="{StaticResource EditorLabel}" Margin="0,0,0,2" />
                        <!-- 2x2, not one row: "Boomerang" alone is wider than
                             this whole side panel, so a single Horizontal
                             StackPanel clips past the panel's right edge
                             (confirmed visually) with no wrap of its own. -->
                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox x:Name="WelcomePhotoIconEnabledCheckBox" Content="Photo" Width="132" Click="WelcomeIconEnabledCheckBox_Click" />
                                <CheckBox x:Name="WelcomeGifIconEnabledCheckBox" Content="GIF" Click="WelcomeIconEnabledCheckBox_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="WelcomeBoomerangIconEnabledCheckBox" Content="Boomerang" Width="132" Click="WelcomeIconEnabledCheckBox_Click" />
                                <CheckBox x:Name="WelcomeVideoIconEnabledCheckBox" Content="Video" Click="WelcomeIconEnabledCheckBox_Click" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Layout" Style="{StaticResource EditorLabel}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="WelcomeIconsRowRadio" GroupName="WelcomeIconsLayout" Content="Row"
                                         Margin="0,0,16,0" Click="WelcomeIconsLayoutRadio_Click" />
                            <RadioButton x:Name="WelcomeIconsColumnRadio" GroupName="WelcomeIconsLayout" Content="Column"
                                         Click="WelcomeIconsLayoutRadio_Click" />
                        </StackPanel>

                        <TextBlock Text="Alignment" Style="{StaticResource EditorLabel}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource IconActionButton}" Width="36" Margin="0,0,6,0" Tag="Start" Click="WelcomeIconsAlignButton_Click">
                                <Path Data="{StaticResource IconAlignLeft}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button Style="{StaticResource IconActionButton}" Width="36" Margin="0,0,6,0" Tag="Center" Click="WelcomeIconsAlignButton_Click">
                                <Path Data="{StaticResource IconAlignCenterH}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button Style="{StaticResource IconActionButton}" Width="36" Tag="End" Click="WelcomeIconsAlignButton_Click">
                                <Path Data="{StaticResource IconAlignRight}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>

                        <CheckBox x:Name="WelcomeShowLiveViewCheckBox" Content="Show live view" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Displays live camera preview." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <CheckBox x:Name="LiveTemplatePreviewCheckBox" Content="Live template preview" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Display live view within the photo placeholders in the template." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <TextBlock Text="Stretch live view" Style="{StaticResource EditorLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="StretchLiveViewCombo" SelectionChanged="StretchLiveViewCombo_SelectionChanged" Margin="0,0,0,10">
                            <ComboBoxItem Content="Fill Screen With Cropping" />
                            <ComboBoxItem Content="Fit Screen" />
                            <ComboBoxItem Content="Stretch To Fill" />
                        </ComboBox>

                        <CheckBox x:Name="BrowseButtonEnabledCheckBox" Content="Browse Button" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Allow guests to see previous sessions." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <CheckBox x:Name="ChooseTemplateEnabledCheckBox" Content="Choose Template" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Allow guests to choose the print template from your favorited ones." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <TextBlock Text="Start screen video" Style="{StaticResource EditorLabel}" />
                        <TextBlock Text="Animation will play in a loop before the Welcome screen appears." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StartScreenVideoNameText" Grid.Column="0" Text="No video selected." Style="{StaticResource EditorLabel}"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0" />
                            <Button x:Name="ChooseStartScreenVideoButton" Grid.Column="1" Content="Choose..." Padding="12,6" Margin="8,0,0,0" Click="ChooseStartScreenVideoButton_Click" />
                        </Grid>

                        <TextBlock Style="{StaticResource BreadcrumbLink}" Margin="0,0,0,14" MouseLeftButtonDown="VirtualAttendantLink_MouseLeftButtonDown">
                            <Run Text="Virtual Attendant" />
                            <Run Text=" &gt;" />
                        </TextBlock>

                        <TextBlock Text="Unlock button opacity" Style="{StaticResource EditorLabel}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="UnlockButtonOpacitySlider" Grid.Column="0" Minimum="0" Maximum="100" ValueChanged="UnlockButtonOpacitySlider_ValueChanged" VerticalAlignment="Center" />
                            <TextBox x:Name="UnlockButtonOpacityBox" Grid.Column="1" Margin="8,0,0,0" TextAlignment="Center" TextChanged="UnlockButtonOpacityBox_TextChanged" />
                        </Grid>

                        <TextBlock Text="Session trigger" Style="{StaticResource EditorSectionHeader}" />
                        <CheckBox x:Name="SessionTriggerTouchScreenCheckBox" Content="Touch Screen" Click="ScreenSettingsCheckBox_Click" Margin="0,0,0,6" />
                        <CheckBox x:Name="SessionTriggerF13CheckBox" Content="F13" Click="ScreenSettingsCheckBox_Click" Margin="0,0,0,6" />
                        <CheckBox x:Name="SessionTriggerKeysCheckBox" Content="Space, S, Page Up, Page Down Keys" Click="ScreenSettingsCheckBox_Click" Margin="0,0,0,10" />

                        <CheckBox x:Name="GuestQrCodeEnabledCheckBox" Content="Guest QR code" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Enable guests to scan a QR code with a camera app to control the booth from their phone." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="CaptureSettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="Background" Style="{StaticResource EditorSectionHeader}" Margin="0,0,0,6" />
                        <TextBlock Text="Only visible where the live view doesn't already cover it (i.e. Show live view off)." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CaptureBackgroundColorSwatch" Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0" />
                            <TextBox x:Name="CaptureBackgroundColorBox" Grid.Column="1" TextChanged="CaptureBackgroundColorBox_TextChanged" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CaptureBackgroundImageNameText" Grid.Column="0" Text="No image selected." Style="{StaticResource EditorLabel}"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0" />
                            <Button x:Name="ChooseCaptureBackgroundImageButton" Grid.Column="1" Content="Choose..." Padding="12,6" Margin="8,0,0,0" Click="ChooseCaptureBackgroundImageButton_Click" />
                        </Grid>

                        <CheckBox x:Name="ShowLiveViewCheckBox" Content="Show live view" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Displays the camera feed behind the Capture screen elements." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <CheckBox x:Name="CropLiveViewCheckBox" Content="Crop live view" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Crop live view on the Capture screen to match template aspect ratio or target video size." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <CheckBox x:Name="MirrorLiveViewCheckBox" Content="Mirror live view" Click="ScreenSettingsCheckBox_Click" Margin="0,0,0,10" />

                        <CheckBox x:Name="SaveMirroredPhotosCheckBox" Content="Save mirrored photos" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="On: the saved photo matches the mirrored preview exactly as seen on screen. Off: the saved photo flips back to true-to-life orientation on capture." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <CheckBox x:Name="AutoTriggerCameraCheckBox" Content="Auto trigger camera" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Capture photo at the end of countdown." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <CheckBox x:Name="FlashScreenWhiteCheckBox" Content="Flash screen white" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Screen turns white at the end of countdown before the photo is captured." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <CheckBox x:Name="ShowCancelButtonCheckBox" Content="Cancel button" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Show cancel button while capturing photos. Drag it on the DESIGN tab's canvas to reposition." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <TextBlock Text="Countdown color" Style="{StaticResource EditorLabel}" />
                        <Grid Margin="0,2,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CountdownColorSwatch" Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0" />
                            <TextBox x:Name="CountdownColorBox" Grid.Column="1" TextChanged="CountdownColorBox_TextChanged" />
                        </Grid>

                        <TextBlock Style="{StaticResource BreadcrumbLink}" Margin="0,0,0,10" MouseLeftButtonDown="CountdownSettingsLink_MouseLeftButtonDown">
                            <Run Text="Countdown settings" />
                            <Run Text=" &gt;" />
                        </TextBlock>

                        <TextBlock Text="Rotation" Style="{StaticResource EditorLabel}" Margin="0,0,0,4" />
                        <UniformGrid Rows="1" Columns="4">
                            <RadioButton x:Name="Rotation0Radio" GroupName="LiveViewRotation" Content="0°" Tag="0" Margin="0,0,4,0" Click="RotationRadio_Click" />
                            <RadioButton x:Name="Rotation90Radio" GroupName="LiveViewRotation" Content="90°" Tag="90" Margin="0,0,4,0" Click="RotationRadio_Click" />
                            <RadioButton x:Name="Rotation180Radio" GroupName="LiveViewRotation" Content="180°" Tag="180" Margin="0,0,4,0" Click="RotationRadio_Click" />
                            <RadioButton x:Name="Rotation270Radio" GroupName="LiveViewRotation" Content="270°" Tag="270" Click="RotationRadio_Click" />
                        </UniformGrid>

                        <TextBlock Text="Thumbnail Strip Settings" Style="{StaticResource EditorSectionHeader}" />
                        <CheckBox x:Name="PhotoThumbnailsEnabledCheckBox" Content="Show thumbnail strip" Click="ScreenSettingsCheckBox_Click" Margin="0,0,0,6" />
                        <TextBlock Text="Where already-taken photos show up on the Capture screen while a guest poses for more." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <TextBlock Text="Position" Style="{StaticResource EditorLabel}" Margin="0,0,0,4" />
                        <UniformGrid Rows="1" Columns="4" Margin="0,0,0,4">
                            <RadioButton x:Name="PoseTopRadio" GroupName="PoseStripPosition" Tag="Top" ToolTip="Top" Margin="0,0,4,0" Click="PoseStripRadio_Click">
                                <Grid Width="16" Height="16">
                                    <Path Data="{StaticResource IconFrameRect}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.4" />
                                    <Path Data="{StaticResource IconDockBandTop}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="PoseBottomRadio" GroupName="PoseStripPosition" Tag="Bottom" ToolTip="Bottom" Margin="0,0,4,0" Click="PoseStripRadio_Click">
                                <Grid Width="16" Height="16">
                                    <Path Data="{StaticResource IconFrameRect}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.4" />
                                    <Path Data="{StaticResource IconDockBandBottom}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="PoseLeftRadio" GroupName="PoseStripPosition" Tag="Left" ToolTip="Left" Margin="0,0,4,0" Click="PoseStripRadio_Click">
                                <Grid Width="16" Height="16">
                                    <Path Data="{StaticResource IconFrameRect}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.4" />
                                    <Path Data="{StaticResource IconDockBandLeft}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="PoseRightRadio" GroupName="PoseStripPosition" Tag="Right" ToolTip="Right" Click="PoseStripRadio_Click">
                                <Grid Width="16" Height="16">
                                    <Path Data="{StaticResource IconFrameRect}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" StrokeThickness="1.4" />
                                    <Path Data="{StaticResource IconDockBandRight}" Fill="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" />
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                        <TextBlock Text="Orientation follows position automatically -- a row for Top/Bottom, a column for Left/Right." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="Background opacity" Style="{StaticResource EditorLabel}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PoseStripOpacitySlider" Grid.Column="0" Minimum="0" Maximum="100" ValueChanged="PoseStripOpacitySlider_ValueChanged" VerticalAlignment="Center" />
                            <TextBox x:Name="PoseStripOpacityBox" Grid.Column="1" Margin="8,0,0,0" TextAlignment="Center" TextChanged="PoseStripOpacityBox_TextChanged" />
                        </Grid>

                        <TextBlock Text="Active shot border color" Style="{StaticResource EditorLabel}" />
                        <Grid Margin="0,2,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PoseStripActiveBorderColorSwatch" Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0" />
                            <TextBox x:Name="PoseStripActiveBorderColorBox" Grid.Column="1" TextChanged="PoseStripActiveBorderColorBox_TextChanged" />
                        </Grid>
                        <TextBlock Text="Highlights whichever slot is the pose currently being captured." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <CheckBox x:Name="PoseStripShowPlaceholderNumbersCheckBox" Content="Placeholder numbers" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Shows 1, 2, 3... on a slot until that shot is taken." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <TextBlock Text="Say Cheese Image" Style="{StaticResource EditorSectionHeader}" />
                        <TextBlock Text="This image shows while the camera is auto-focusing after countdown has ended." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SayCheeseImageNameText" Grid.Column="0" Text="No image selected." Style="{StaticResource EditorLabel}"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0" />
                            <Button x:Name="ChooseSayCheeseImageButton" Grid.Column="1" Content="Choose..." Padding="12,6" Margin="8,0,0,0" Click="ChooseSayCheeseImageButton_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="SharingSettingsPanel" Visibility="Collapsed">
                        <TextBlock Text="Background" Style="{StaticResource EditorSectionHeader}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SharingBackgroundColorSwatch" Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,8,0" />
                            <TextBox x:Name="SharingBackgroundColorBox" Grid.Column="1" TextChanged="SharingBackgroundColorBox_TextChanged" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SharingBackgroundImageNameText" Grid.Column="0" Text="No image selected." Style="{StaticResource EditorLabel}"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0" />
                            <Button x:Name="ChooseSharingBackgroundImageButton" Grid.Column="1" Content="Choose..." Padding="12,6" Margin="8,0,0,0" Click="ChooseSharingBackgroundImageButton_Click" />
                        </Grid>

                        <CheckBox x:Name="SkipSharingScreenCheckBox" Content="Skip Sharing Screen" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Guests go straight to a new session instead of seeing the Sharing screen." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <CheckBox x:Name="ShowDoneButtonCheckBox" Content="Done button" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Lets guests end the Sharing screen manually instead of waiting for the timeout." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <TextBlock Text="Sharing icons location" Style="{StaticResource EditorLabel}" Margin="0,0,0,4" />
                        <ComboBox x:Name="SharingIconsLocationCombo" SelectionChanged="SharingIconsLocationCombo_SelectionChanged" Margin="0,0,0,10">
                            <ComboBoxItem Content="Custom" />
                            <ComboBoxItem Content="Bottom Row" />
                            <ComboBoxItem Content="Grid" />
                        </ComboBox>

                        <CheckBox x:Name="SharingTextLabelsEnabledCheckBox" Content="Text labels" Click="ScreenSettingsCheckBox_Click" Margin="0,0,0,10" />

                        <!-- Sharing icon row (QR/Email/SMS/Print) - drag the
                             group on the DESIGN tab's canvas to reposition it.
                             Each icon's own enabled state is QR/Email/SMS/
                             Print's real channel toggle, edited via "Sharing
                             Settings" below (not this editor) since those also
                             gate whether the channel actually works, not just
                             whether its icon shows here. -->
                        <CheckBox x:Name="SharingIconsGroupEnabledCheckBox" Content="Sharing icons" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Hides the whole QR/Email/SMS/Print group when off." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10" />

                        <TextBlock Text="Icon layout" Style="{StaticResource EditorLabel}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="SharingIconsRowRadio" GroupName="SharingIconsLayout" Content="Row"
                                         Margin="0,0,16,0" Click="SharingIconsLayoutRadio_Click" />
                            <RadioButton x:Name="SharingIconsColumnRadio" GroupName="SharingIconsLayout" Content="Column"
                                         Click="SharingIconsLayoutRadio_Click" />
                        </StackPanel>

                        <TextBlock Text="Icon alignment" Style="{StaticResource EditorLabel}" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Style="{StaticResource IconActionButton}" Width="36" Margin="0,0,6,0" Tag="Start" Click="SharingIconsAlignButton_Click">
                                <Path Data="{StaticResource IconAlignLeft}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button Style="{StaticResource IconActionButton}" Width="36" Margin="0,0,6,0" Tag="Center" Click="SharingIconsAlignButton_Click">
                                <Path Data="{StaticResource IconAlignCenterH}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button Style="{StaticResource IconActionButton}" Width="36" Tag="End" Click="SharingIconsAlignButton_Click">
                                <Path Data="{StaticResource IconAlignRight}" Stretch="Uniform" Width="15" Height="15" Stroke="{StaticResource InkBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Final screen timeout" Style="{StaticResource EditorLabel}" />
                        <TextBlock Text="Duration to display the Sharing screen." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FinalScreenTimeoutSlider" Grid.Column="0" Minimum="5" Maximum="120" ValueChanged="FinalScreenTimeoutSlider_ValueChanged" VerticalAlignment="Center" />
                            <TextBox x:Name="FinalScreenTimeoutBox" Grid.Column="1" Margin="8,0,0,0" TextAlignment="Center" TextChanged="FinalScreenTimeoutBox_TextChanged" />
                        </Grid>

                        <CheckBox x:Name="ShowOriginalPhotosCheckBox" Content="Show original photos" Click="ScreenSettingsCheckBox_Click" />
                        <TextBlock Text="Show single images without template." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <CheckBox x:Name="ShowRetakeButtonCheckBox" Content="Retake button" Click="ScreenSettingsCheckBox_Click" Margin="0,0,0,14" />

                        <TextBlock Style="{StaticResource BreadcrumbLink}" MouseLeftButtonDown="SharingSettingsLink_MouseLeftButtonDown">
                            <Run Text="Sharing Settings" />
                            <Run Text=" &gt;" />
                        </TextBlock>
                        <TextBlock Text="Which channels are offered (Email/SMS/Twitter/QR/Print) is configured there." Style="{StaticResource EditorLabel}"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
            <TextBlock x:Name="EditorStatusText" Style="{StaticResource EditorLabel}" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Padding="18,9" Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Padding="20,9" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
