<Window x:Class="Photobooth.UI.ScreenTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Screen Layout"
        Background="{DynamicResource CanvasBrush}"
        WindowStartupLocation="CenterOwner"
        Width="900"
        Height="640">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkPalette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="EditorSectionHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Margin" Value="0,16,0,6" />
            </Style>
            <Style x:Key="EditorLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Margin" Value="0,4,0,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="SCREEN LAYOUT EDITOR"
                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

        <!-- One tab per guest-facing screen (see ScreenTemplateScreen); switching
             tabs swaps which screen's working element list ElementsCanvas below is
             showing/editing, same reusable-canvas approach the ScreenTemplateEditorWindow
             code comment explains, rather than three separate canvases. -->
        <TabControl x:Name="ScreenTabControl" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                    SelectionChanged="ScreenTabControl_SelectionChanged" Margin="0,0,0,10">
            <TabItem Header="Welcome" Tag="Welcome" />
            <TabItem Header="Capture" Tag="Capture" />
            <TabItem Header="Sharing" Tag="Sharing" />
        </TabControl>

        <!-- ElementsCanvas is the live view itself (no separate rendered preview
             like PrintTemplateEditorWindow's PreviewImage); these are placed
             WPF elements, not composited onto a captured photo. -->
        <Border Grid.Row="2" Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas x:Name="ElementsCanvas" Background="#F4F3F0" />
        </Border>

        <!-- DESIGN/SETTINGS split, matching dslrBooth's own Screen Editor side
             panel (see BUILD_PLAN.md/the reference screenshots): DESIGN holds
             everything about the elements on the active screen's canvas,
             SETTINGS holds the screen-chrome toggles that used to have no
             editable UI anywhere in this build (see ScreenSettings and
             AdminWindow's own "ScreenSettings has no editable UI" comment,
             now closed by this tab). -->
        <TabControl Grid.Row="2" Grid.Column="1" Margin="16,0,0,0">
            <TabItem Header="DESIGN">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Add element" Style="{StaticResource EditorSectionHeader}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddTextButton" Content="+ Text" Padding="10,6" Margin="0,0,8,0" Click="AddTextButton_Click" />
                        <Button x:Name="AddImageButton" Content="+ Image" Padding="10,6" Margin="0,0,8,0" Click="AddImageButton_Click" />
                        <Button x:Name="AddShapeButton" Content="+ Shape" Padding="10,6" Click="AddShapeButton_Click" />
                    </StackPanel>

                    <!-- Aligns the selected element against the canvas bounds
                         (left/center/right, top/middle/bottom): the single-
                         element subset of dslrBooth's own Alignment grid; that
                         reference also aligns multi-selections relative to each
                         other, which this editor's single-selection model
                         doesn't support. -->
                    <TextBlock Text="Alignment" Style="{StaticResource EditorSectionHeader}" />
                    <UniformGrid Rows="2" Columns="3">
                        <Button x:Name="AlignLeftButton" Content="Left" Padding="6,5" Margin="0,0,4,4" ToolTip="Align left" Click="AlignButton_Click" Tag="Left" />
                        <Button x:Name="AlignCenterButton" Content="Center" Padding="6,5" Margin="0,0,4,4" ToolTip="Center horizontally" Click="AlignButton_Click" Tag="CenterHorizontal" />
                        <Button x:Name="AlignRightButton" Content="Right" Padding="6,5" Margin="0,0,0,4" ToolTip="Align right" Click="AlignButton_Click" Tag="Right" />
                        <Button x:Name="AlignTopButton" Content="Top" Padding="6,5" Margin="0,0,4,0" ToolTip="Align top" Click="AlignButton_Click" Tag="Top" />
                        <Button x:Name="AlignMiddleButton" Content="Middle" Padding="6,5" Margin="0,0,4,0" ToolTip="Center vertically" Click="AlignButton_Click" Tag="CenterVertical" />
                        <Button x:Name="AlignBottomButton" Content="Bottom" Padding="6,5" ToolTip="Align bottom" Click="AlignButton_Click" Tag="Bottom" />
                    </UniformGrid>

                    <TextBlock Text="Layers" Style="{StaticResource EditorSectionHeader}" />
                    <ListBox x:Name="LayerListBox" Height="90" SelectionChanged="LayerListBox_SelectionChanged" />

                    <TextBlock Text="Selected element" Style="{StaticResource EditorSectionHeader}" />
                    <TextBlock x:Name="NoSelectionText" Text="Tap an element on the canvas to edit it." Style="{StaticResource EditorLabel}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

                    <StackPanel x:Name="TextPropertiesPanel" Visibility="Collapsed">
                        <TextBlock Text="Text" Style="{StaticResource EditorLabel}" />
                        <TextBox x:Name="ElementTextBox" TextChanged="ElementTextBox_TextChanged" />

                        <TextBlock Text="Font size" Style="{StaticResource EditorLabel}" />
                        <Slider x:Name="FontSizeSlider" Minimum="0.02" Maximum="0.15" ValueChanged="FontSizeSlider_ValueChanged" />

                        <CheckBox x:Name="BoldCheckBox" Content="Bold" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" Click="BoldCheckBox_Click" />

                        <TextBlock Text="Color (hex)" Style="{StaticResource EditorLabel}" />
                        <TextBox x:Name="ElementColorBox" TextChanged="ElementColorBox_TextChanged" />
                    </StackPanel>

                    <StackPanel x:Name="ImagePropertiesPanel" Visibility="Collapsed">
                        <TextBlock Text="Image" Style="{StaticResource EditorLabel}" />
                        <Button x:Name="ChangeImageButton" Content="Browse..." Padding="8,4" HorizontalAlignment="Left" Click="ChangeImageButton_Click" />
                    </StackPanel>

                    <StackPanel x:Name="ShapePropertiesPanel" Visibility="Collapsed">
                        <TextBlock Text="Fill color (hex)" Style="{StaticResource EditorLabel}" />
                        <TextBox x:Name="ShapeColorBox" TextChanged="ElementColorBox_TextChanged" />
                    </StackPanel>

                    <Button x:Name="DeleteSelectedButton" Content="Delete selected" Padding="10,6" Margin="0,16,0,0"
                            HorizontalAlignment="Left" IsEnabled="False" Click="DeleteSelectedButton_Click" />
                </StackPanel>
            </TabItem>

            <TabItem Header="SETTINGS">
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="Welcome screen" Style="{StaticResource EditorSectionHeader}" Margin="0,0,0,6" />
                    <CheckBox x:Name="BoothIconsEnabledCheckBox" Content="Booth icons" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" Click="ScreenSettingsCheckBox_Click" />
                    <TextBlock Text="If off, touching anywhere on the Welcome screen starts a session." Style="{StaticResource EditorLabel}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,10" />

                    <TextBlock Text="Live view" Style="{StaticResource EditorSectionHeader}" />
                    <CheckBox x:Name="ShowLiveViewCheckBox" Content="Show live view" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" Click="ScreenSettingsCheckBox_Click" />
                    <CheckBox x:Name="MirrorLiveViewCheckBox" Content="Mirror live view" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" Click="ScreenSettingsCheckBox_Click" />

                    <TextBlock Text="Live view rotation" Style="{StaticResource EditorLabel}" Margin="0,10,0,2" />
                    <ComboBox x:Name="LiveViewRotationCombo" Width="120" HorizontalAlignment="Left" SelectionChanged="LiveViewRotationCombo_SelectionChanged">
                        <ComboBoxItem Content="0°" Tag="0" />
                        <ComboBoxItem Content="90°" Tag="90" />
                        <ComboBoxItem Content="180°" Tag="180" />
                        <ComboBoxItem Content="270°" Tag="270" />
                    </ComboBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <TextBlock x:Name="EditorStatusText" Style="{StaticResource EditorLabel}" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button x:Name="SaveButton" Content="Save" Padding="16,8" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
