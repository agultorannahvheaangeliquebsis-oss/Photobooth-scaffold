<Window x:Class="Photobooth.UI.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterOwner"
        Width="480"
        Height="820">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="Row" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ADMIN DASHBOARD" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}" />

        <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Sessions today" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="SessionsTodayText" Text="Loading..." Style="{StaticResource Row}" />

                <TextBlock Text="Revenue by mode" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="RevenueList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Row}"
                                       Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="RevenueEmptyText" Text="No paid sessions yet." Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />

                <TextBlock Text="Guest feedback" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="FeedbackAverageText" Text="Loading..." Style="{StaticResource Row}" />
                <ItemsControl x:Name="FeedbackCommentsList" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Row}" TextWrapping="Wrap"
                                       Text="{Binding}" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Low inventory alerts" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="InventoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Row}" Foreground="#B3261E"
                                       Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="InventoryEmptyText" Text="Nothing running low." Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />

                <!-- Takes effect for the next guest session, not the app's
                     next restart: BoothStateMachine reads these fresh at
                     the start of every RunSessionAsync call. -->
                <TextBlock Text="Booth settings" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Countdown (seconds):" Style="{StaticResource Row}" VerticalAlignment="Center" Width="220" />
                    <TextBox x:Name="CountdownSecondsBox" Width="60" />
                </StackPanel>
                <CheckBox x:Name="GlamFilterCheckBox" Content="Glam Booth mode (high-contrast B&amp;W filter)"
                          Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" />

                <!-- Gates the startup Setup/Launch Event screen (see MainWindow's
                     SetupView): an admin enters this PIN there before they can
                     open settings or launch the event for guests. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Admin PIN (Setup screen):" Style="{StaticResource Row}" VerticalAlignment="Center" Width="220" />
                    <TextBox x:Name="AdminPinBox" Width="100" MaxLength="20" />
                </StackPanel>

                <TextBlock Text="Print template" Style="{StaticResource Row}" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <RadioButton x:Name="SingleLayoutRadio" GroupName="PrintLayout" Content="Single"
                                 Foreground="{StaticResource InkBrush}" IsChecked="True" Margin="0,0,16,0" />
                    <RadioButton x:Name="StripLayoutRadio" GroupName="PrintLayout" Content="Strip"
                                 Foreground="{StaticResource InkBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Paper width (in):" Style="{StaticResource Row}" VerticalAlignment="Center" Width="120" />
                    <TextBox x:Name="PrintWidthBox" Width="60" Margin="0,0,16,0" />
                    <TextBlock Text="height (in):" Style="{StaticResource Row}" VerticalAlignment="Center" Width="70" />
                    <TextBox x:Name="PrintHeightBox" Width="60" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Strip copies:" Style="{StaticResource Row}" VerticalAlignment="Center" Width="120" />
                    <TextBox x:Name="StripCopiesBox" Width="60" />
                </StackPanel>
                <TextBlock Text="Strip copies only applies when Strip is selected -- e.g. 2 photos stacked on a 2x6." Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <Button x:Name="EditPrintTemplateButton" Content="Edit print template..." Padding="8,4"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="EditPrintTemplateButton_Click" />
                <!-- Visual Screen Editor (Phase 6), Welcome/Capture/Sharing overlay
                     elements, same "own editor window, reload after Save" pattern as
                     EditPrintTemplateButton above. -->
                <Button x:Name="EditScreenLayoutButton" Content="Edit screen layout..." Padding="8,4"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="EditScreenLayoutButton_Click" />

                <TextBlock x:Name="SettingsStatusText" Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                <Button x:Name="SaveSettingsButton" Content="Save Settings" Padding="16,8"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveSettingsButton_Click" />

                <!-- Colors/logo/event name applied by MainWindow at startup and
                     every time it returns to Idle: takes effect for the next
                     guest, but won't repaint mid-session. -->
                <TextBlock Text="Theme" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Accent color (hex):" Style="{StaticResource Row}" VerticalAlignment="Center" Width="150" />
                    <TextBox x:Name="AccentColorBox" Width="90" Margin="0,0,8,0" TextChanged="ThemeColorBox_TextChanged" />
                    <Border x:Name="AccentColorSwatch" Width="20" Height="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Canvas color (hex):" Style="{StaticResource Row}" VerticalAlignment="Center" Width="150" />
                    <TextBox x:Name="CanvasColorBox" Width="90" Margin="0,0,8,0" TextChanged="ThemeColorBox_TextChanged" />
                    <Border x:Name="CanvasColorSwatch" Width="20" Height="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Ink color (hex):" Style="{StaticResource Row}" VerticalAlignment="Center" Width="150" />
                    <TextBox x:Name="InkColorBox" Width="90" Margin="0,0,8,0" TextChanged="ThemeColorBox_TextChanged" />
                    <Border x:Name="InkColorSwatch" Width="20" Height="20" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Event/brand name:" Style="{StaticResource Row}" VerticalAlignment="Center" Width="150" />
                    <TextBox x:Name="EventNameBox" Width="220" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BrowseThemeLogoButton" Content="Browse for logo..." Padding="8,4" Click="BrowseThemeLogoButton_Click" />
                </StackPanel>
                <TextBlock x:Name="SelectedThemeLogoText" Text="No logo selected." Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                <TextBlock x:Name="ThemeStatusText" Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <Button x:Name="SaveThemeButton" Content="Save Theme" Padding="16,8"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveThemeButton_Click" />

                <!-- Frames an admin adds here show up in the guest-facing
                     FramePicker screen (see MainWindow's FramePickerView):
                     takes effect for the next guest session, no restart. -->
                <TextBlock Text="Frame library" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="FramesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Row}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsActive, Mode=OneWay}" Content="Active"
                                          Tag="{Binding FrameId}" Margin="8,0" VerticalAlignment="Center" Click="FrameActiveCheckBox_Click" />
                                <Button Grid.Column="2" Content="Delete" Padding="8,4" Tag="{Binding FrameId}" Click="DeleteFrameButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="FramesEmptyText" Text="No frames added yet -- FramePicker won't show for guests until one exists."
                           Style="{StaticResource Row}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="New frame name:" Style="{StaticResource Row}" VerticalAlignment="Center" Width="120" />
                    <TextBox x:Name="NewFrameNameBox" Width="140" Margin="0,0,8,0" />
                    <Button x:Name="BrowseFrameImageButton" Content="Browse..." Padding="8,4" Click="BrowseFrameImageButton_Click" />
                </StackPanel>
                <TextBlock x:Name="SelectedFrameImageText" Text="No image selected." Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                <Button x:Name="AddFrameButton" Content="Add Frame" Padding="16,8"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddFrameButton_Click" />
                <TextBlock x:Name="FrameStatusText" Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <!-- Recordings from BoothStateMachine's Guestbook state: stored
                     locally and reviewed here only, never uploaded/QR'd/printed
                     like the photo is (see GuestbookVideo's schema comment). -->
                <TextBlock Text="Guestbook messages" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="GuestbookVideosList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Row}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Open" Padding="8,4" Margin="8,0" Tag="{Binding FilePath}" Click="OpenGuestbookVideoButton_Click" />
                                <Button Grid.Column="2" Content="Delete" Padding="8,4" Tag="{Binding GuestbookVideoId}" Click="DeleteGuestbookVideoButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="GuestbookVideosEmptyText" Text="No guestbook messages recorded yet."
                           Style="{StaticResource Row}" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />

                <!-- dslrBooth feature-parity settings (BUILD_PLAN.md Phase 3), backed
                     by Location's new columns via LocationRepository's
                     UpdateDslrBoothParitySettingsAsync. Takes effect for the next
                     guest session, same as the Booth settings section above. -->
                <TextBlock Text="Capture Settings" Style="{StaticResource SectionHeader}" />
                <TextBlock Text="Mode:" Style="{StaticResource Row}" />
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <RadioButton x:Name="CaptureModePhotoRadio" GroupName="CaptureMode" Content="Photo"
                                 Foreground="{StaticResource InkBrush}" IsChecked="True" Margin="0,0,12,0" />
                    <RadioButton x:Name="CaptureModeGifRadio" GroupName="CaptureMode" Content="GIF"
                                 Foreground="{StaticResource InkBrush}" Margin="0,0,12,0" />
                    <RadioButton x:Name="CaptureModeBoomerangRadio" GroupName="CaptureMode" Content="Boomerang"
                                 Foreground="{StaticResource InkBrush}" Margin="0,0,12,0" />
                    <RadioButton x:Name="CaptureModeVideoRadio" GroupName="CaptureMode" Content="Video"
                                 Foreground="{StaticResource InkBrush}" />
                </StackPanel>
                <CheckBox x:Name="AlsoCreateGifCheckBox" Content="Also create a GIF alongside the main capture"
                          Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="GIF/Boomerang frame count:" Style="{StaticResource Row}" VerticalAlignment="Center" Width="220" />
                    <TextBox x:Name="FrameCountBox" Width="60" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Frame delay (ms):" Style="{StaticResource Row}" VerticalAlignment="Center" Width="220" />
                    <TextBox x:Name="FrameDelayBox" Width="60" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Video duration (seconds):" Style="{StaticResource Row}" VerticalAlignment="Center" Width="220" />
                    <TextBox x:Name="VideoDurationBox" Width="60" />
                </StackPanel>

                <TextBlock Text="Effects &amp; Stickers" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="BeautyFilterCheckBox" Content="Beauty filter enabled"
                          Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                <TextBlock Text="Filters mode:" Style="{StaticResource Row}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <RadioButton x:Name="FiltersModeAskRadio" GroupName="FiltersMode" Content="Ask"
                                 Foreground="{StaticResource InkBrush}" IsChecked="True" Margin="0,0,12,0" />
                    <RadioButton x:Name="FiltersModeAutoRadio" GroupName="FiltersMode" Content="Auto"
                                 Foreground="{StaticResource InkBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BrowseWatermarkButton" Content="Browse for watermark..." Padding="8,4" Click="BrowseWatermarkButton_Click" />
                </StackPanel>
                <TextBlock x:Name="SelectedWatermarkText" Text="No watermark selected." Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />

                <TextBlock Text="Green Screen" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="GreenScreenEnabledCheckBox" Content="Green screen enabled"
                          Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BrowseGreenScreenBackgroundButton" Content="Browse for background..." Padding="8,4" Click="BrowseGreenScreenBackgroundButton_Click" />
                </StackPanel>
                <TextBlock x:Name="SelectedGreenScreenBackgroundText" Text="No background selected." Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />

                <!-- Question-builder + responses list added in Phase 6 (see
                     BUILD_PLAN.md); SurveyEnabledCheckBox is the same on/off
                     switch from Phase 1/3, saved via SaveParitySettingsButton
                     alongside Capture/Effects/etc below. Questions/Responses are
                     saved immediately on Add/Delete, same as the Frame library. -->
                <TextBlock Text="Survey" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="SurveyEnabledCheckBox" Content="Post-session survey enabled"
                          Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />

                <TextBlock Text="Questions" Style="{StaticResource Row}" FontWeight="SemiBold" Margin="0,10,0,0" />
                <ItemsControl x:Name="SurveyQuestionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Text}" Style="{StaticResource Row}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Delete" Padding="8,4" Tag="{Binding SurveyQuestionId}" Click="DeleteSurveyQuestionButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SurveyQuestionsEmptyText" Text="No questions added yet -- the Survey screen won't show for guests until one exists."
                           Style="{StaticResource Row}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="New question:" Style="{StaticResource Row}" VerticalAlignment="Center" Width="120" />
                    <TextBox x:Name="NewSurveyQuestionBox" Width="260" />
                </StackPanel>
                <Button x:Name="AddSurveyQuestionButton" Content="+ Question" Padding="16,8"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddSurveyQuestionButton_Click" />
                <TextBlock x:Name="SurveyQuestionStatusText" Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />

                <TextBlock Text="Responses" Style="{StaticResource Row}" FontWeight="SemiBold" Margin="0,14,0,0" />
                <ItemsControl x:Name="SurveyResponsesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Row}" Margin="0,2" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="SurveyResponsesEmptyText" Text="No responses recorded yet."
                           Style="{StaticResource Row}" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />

                <TextBlock Text="Disclaimer" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Header:" Style="{StaticResource Row}" VerticalAlignment="Center" Width="120" />
                    <TextBox x:Name="DisclaimerHeaderBox" Width="280" />
                </StackPanel>
                <TextBlock Text="Text:" Style="{StaticResource Row}" Margin="0,6,0,2" />
                <TextBox x:Name="DisclaimerTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                         Height="80" VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Sharing Settings" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="EmailEnabledCheckBox" Content="Email sharing enabled"
                          Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                <CheckBox x:Name="SmsEnabledCheckBox" Content="SMS sharing enabled"
                          Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" />
                <CheckBox x:Name="QrEnabledCheckBox" Content="QR sharing enabled"
                          Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" />

                <TextBlock Text="Print Setup extensions" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="PrintAutomaticallyCheckBox" Content="Print automatically"
                          Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" />
                <CheckBox x:Name="ShowPrintButtonCheckBox" Content="Show print button to guests"
                          Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Print limit per event:" Style="{StaticResource Row}" VerticalAlignment="Center" Width="220" />
                    <TextBox x:Name="PrintLimitPerEventBox" Width="80" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Print limit per session:" Style="{StaticResource Row}" VerticalAlignment="Center" Width="220" />
                    <TextBox x:Name="PrintLimitPerSessionBox" Width="80" />
                </StackPanel>
                <TextBlock Text="Print sharpening:" Style="{StaticResource Row}" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <RadioButton x:Name="PrintSharpeningLowRadio" GroupName="PrintSharpening" Content="Low"
                                 Foreground="{StaticResource InkBrush}" Margin="0,0,12,0" />
                    <RadioButton x:Name="PrintSharpeningMediumRadio" GroupName="PrintSharpening" Content="Medium"
                                 Foreground="{StaticResource InkBrush}" IsChecked="True" Margin="0,0,12,0" />
                    <RadioButton x:Name="PrintSharpeningHighRadio" GroupName="PrintSharpening" Content="High"
                                 Foreground="{StaticResource InkBrush}" />
                </StackPanel>

                <TextBlock x:Name="ParitySettingsStatusText" Style="{StaticResource Row}"
                           Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <Button x:Name="SaveParitySettingsButton" Content="Save Capture/Effects/Sharing Settings" Padding="16,8"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Click="SaveParitySettingsButton_Click" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="RefreshButton" Content="Refresh" Padding="16,8" Margin="0,0,8,0" Click="RefreshButton_Click" />
            <Button x:Name="CloseButton" Content="Close" Padding="16,8" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
