<Application x:Class="Photobooth.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#F4F3F0" />
        <SolidColorBrush x:Key="InkBrush" Color="#202124" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6E706F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#365C58" />
        <SolidColorBrush x:Key="LineBrush" Color="#D9D8D3" />
    </Application.Resources>
</Application>
