<Window x:Class="Photobooth.UI.SlideshowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slideshow"
        Background="Black"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Width="1024" Height="768"
        KeyDown="Window_KeyDown">
    <Grid>
        <!-- Two overlapped Image controls: the crossfade in code-behind
             animates one's Opacity down while the other's goes up, rather
             than swapping a single Image's Source (which would hard-cut). -->
        <Image x:Name="PrimaryImage" Stretch="Uniform" Opacity="1" />
        <Image x:Name="SecondaryImage" Stretch="Uniform" Opacity="0" />

        <TextBlock x:Name="EmptyStateText" Text="No photos captured yet this event -- the slideshow starts automatically once the first guest photo is saved."
                   Foreground="#9A9C9F" FontFamily="Segoe UI" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Visibility="Collapsed" />

        <!-- Event logo overlay (see AdminWindow's Slideshow section, "Show
             event logo overlay") -->
        <Image x:Name="LogoOverlayImage" Stretch="Uniform" MaxHeight="80" MaxWidth="220"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32" Visibility="Collapsed" />

        <TextBlock x:Name="EventNameText" Foreground="White" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="32"
                   Opacity="0.85" />

        <TextBlock Text="Press Esc to close" Foreground="White" FontFamily="Segoe UI" FontSize="12"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32" Opacity="0.4" />
    </Grid>
</Window>
