<Window x:Class="Photobooth.UI.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photobooth" Background="#17181A"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="380" SizeToContent="Height">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#F2F2F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9A9C9F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4FBFAE" />
        <SolidColorBrush x:Key="LineBrush" Color="#2C2E31" />
        <SolidColorBrush x:Key="FieldBrush" Color="#1F2023" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0C0D" />

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="28">
        <TextBlock x:Name="PromptTitleText" Text="Name this event" FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" />
        <TextBlock x:Name="PromptCaptionText" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,18" Visibility="Collapsed" />

        <TextBox x:Name="ValueTextBox" MaxLength="100" KeyDown="ValueTextBox_KeyDown" />
        <TextBlock x:Name="ErrorText" FontFamily="Segoe UI" FontSize="12" Foreground="#E5484D"
                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="CANCEL" Padding="16,8" Margin="0,0,10,0" Click="CancelButton_Click" IsCancel="True" />
            <Button x:Name="OkButton" Content="OK" Style="{StaticResource PrimaryButton}" Padding="18,8" Click="OkButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
