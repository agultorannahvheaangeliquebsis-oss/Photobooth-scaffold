<Window x:Class="Photobooth.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Focus &amp; Snap"
        Icon="Assets/Logo.png"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinWidth="800"
        MinHeight="600"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ScreenTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="42" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ScreenSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Background="Transparent" is required, not cosmetic: a panel with a null
         Background is not hit-test visible, so taps landing on empty space
         (most of a full-screen booth window) would never reach this handler. -->
    <Grid Background="Transparent" MouseLeftButtonUp="Surface_MouseLeftButtonUp">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="FOCUS &amp; SNAP" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}" Margin="0,34,0,0"
                   HorizontalAlignment="Center" />

        <Grid Grid.Row="1" Margin="48,24,48,24">
            <StackPanel x:Name="IdleView" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Make a moment of it." Style="{StaticResource ScreenTitle}" />
                <TextBlock Text="Your photo is waiting." Style="{StaticResource ScreenSubtitle}" Margin="0,18,0,54" />
                <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="36,20" HorizontalAlignment="Center">
                    <TextBlock Text="TAP TO START" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                </Border>
            </StackPanel>

            <StackPanel x:Name="ConsentView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <TextBlock Text="Before you strike a pose" Style="{StaticResource ScreenTitle}" />
                <TextBlock Text="By continuing, you agree to let Focus &amp; Snap capture and print your photo, and use it for the event gallery. You'll also get the option to receive a digital copy by email."
                           Style="{StaticResource ScreenSubtitle}" TextWrapping="Wrap" Margin="0,18,0,0" />
                <TextBlock Text="Reading and confirming..." Style="{StaticResource ScreenSubtitle}" FontSize="16" Margin="0,24,0,0" />
            </StackPanel>

            <Grid x:Name="CountdownView" Visibility="Collapsed">
                <!-- Live camera preview fills the screen behind the countdown;
                     LiveViewImage.Source is only ever set while this state is
                     showing (see MainWindow.xaml.cs), so it's just blank space
                     the rest of the time. -->
                <Image x:Name="LiveViewImage" Stretch="UniformToFill" />
                <StackPanel Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Get ready" Style="{StaticResource ScreenSubtitle}" />
                    <TextBlock x:Name="CountdownNumber" Text="3" FontSize="180" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="CapturingView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Say cheese!" Style="{StaticResource ScreenTitle}" />
                <TextBlock Text="Hold that smile..." Style="{StaticResource ScreenSubtitle}" Margin="0,18,0,0" />
            </StackPanel>

            <StackPanel x:Name="ReviewingView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Great shot." Style="{StaticResource ScreenTitle}" />
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" Padding="12" Margin="0,24,0,0">
                    <Grid Width="360" Height="240">
                        <Image x:Name="CapturedImage" Stretch="Uniform" />
                        <TextBlock x:Name="PhotoFallback" Text="Your photo is ready to print" Style="{StaticResource ScreenSubtitle}"
                                   VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="FramePickerView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="700">
                <TextBlock Text="Pick a frame" Style="{StaticResource ScreenTitle}" />
                <TextBlock Text="Tap one to add it to your photo, or skip." Style="{StaticResource ScreenSubtitle}" Margin="0,10,0,24" />
                <!-- Populated in code-behind (ShowFrameOptions) each time UiFrameSelectionService
                     raises SelectionRequested: one button per active frame plus "No frame". -->
                <WrapPanel x:Name="FrameOptionsPanel" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="PaymentView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock Text="Complete your payment" Style="{StaticResource ScreenTitle}" />
                <!-- Text is gateway-specific (set from BoothStateMachine.PaymentInstructions in
                     code-behind) since "Scan to pay" doesn't apply to a card-reader gateway. -->
                <TextBlock x:Name="PaymentInstructionsText" Style="{StaticResource ScreenSubtitle}" TextWrapping="Wrap" Margin="0,18,0,0" />
                <!-- Collapsed in code-behind for a gateway with nothing to scan (e.g. a card reader). -->
                <Border x:Name="PaymentQrBorder" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White" Padding="16" Margin="0,24,0,0" HorizontalAlignment="Center">
                    <Image x:Name="PaymentQrCodeImage" Width="220" Height="220" />
                </Border>
            </StackPanel>

            <StackPanel x:Name="PrintingView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Printing your photo..." Style="{StaticResource ScreenTitle}" />
                <ProgressBar IsIndeterminate="True" Width="260" Height="6" Margin="0,32,0,0"
                             Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <StackPanel x:Name="CompleteView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Thank you!" Style="{StaticResource ScreenTitle}" />
                <TextBlock Text="Enjoy your moment." Style="{StaticResource ScreenSubtitle}" Margin="0,18,0,0" />
            </StackPanel>

            <StackPanel x:Name="FeedbackView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                <TextBlock Text="How was your experience?" Style="{StaticResource ScreenTitle}" />
                <TextBlock Text="Totally optional -- helps us make Focus &amp; Snap better." Style="{StaticResource ScreenSubtitle}" Margin="0,10,0,24" />
                <!-- Five star buttons, tagged "1".."5"; StarButton_Click sets
                     _selectedFeedbackRating and UpdateStarButtons repaints
                     them filled up to that rating. -->
                <StackPanel x:Name="FeedbackStarsPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="☆" Tag="1" FontSize="32" Padding="6,0" Background="Transparent" BorderThickness="0" Click="StarButton_Click" />
                    <Button Content="☆" Tag="2" FontSize="32" Padding="6,0" Background="Transparent" BorderThickness="0" Click="StarButton_Click" />
                    <Button Content="☆" Tag="3" FontSize="32" Padding="6,0" Background="Transparent" BorderThickness="0" Click="StarButton_Click" />
                    <Button Content="☆" Tag="4" FontSize="32" Padding="6,0" Background="Transparent" BorderThickness="0" Click="StarButton_Click" />
                    <Button Content="☆" Tag="5" FontSize="32" Padding="6,0" Background="Transparent" BorderThickness="0" Click="StarButton_Click" />
                </StackPanel>
                <TextBox x:Name="FeedbackCommentBox" Margin="0,20,0,0" Padding="10" FontSize="16"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                         Text="" />
                <TextBlock Text="Leave a comment (optional)" Style="{StaticResource ScreenSubtitle}" FontSize="14"
                           Margin="0,4,0,0" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Padding="28,14" Margin="0,0,12,0" Background="{StaticResource AccentBrush}"
                            BorderThickness="0" Click="SubmitFeedbackButton_Click">
                        <TextBlock Text="SUBMIT" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                    </Button>
                    <Button Padding="28,14" Background="Transparent" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" Click="SkipFeedbackButton_Click">
                        <TextBlock Text="SKIP" Foreground="{StaticResource MutedBrush}" FontSize="16" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ErrorView" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <TextBlock Text="Something went wrong" Style="{StaticResource ScreenTitle}" />
                <TextBlock x:Name="ErrorMessage" Style="{StaticResource ScreenSubtitle}" TextWrapping="Wrap" Margin="0,18,0,0" />
                <TextBlock Text="Returning to the welcome screen..." Style="{StaticResource ScreenSubtitle}" FontSize="16" Margin="0,12,0,0" />
            </StackPanel>

            <!-- Shown over Printing/Complete once the background upload finishes;
                 those two screens are the only ones with enough natural dwell time
                 for a guest to actually scan a code before walking away. -->
            <Border x:Name="QrPanel" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="16">
                <StackPanel HorizontalAlignment="Center">
                    <Image x:Name="QrCodeImage" Width="140" Height="140" />
                    <TextBlock Text="Scan to download" Style="{StaticResource ScreenSubtitle}" FontSize="14" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="A PHOTO TO KEEP" FontSize="12" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,28" />
    </Grid>
</Window>
