<Window x:Class="Photobooth.UI.AddCustomFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Custom Filter" Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Width="460" SizeToContent="Height">
    <Window.Resources>
        <!-- Same locally-scoped dark palette FilterLibraryWindow already
             established (see its own Window.Resources comment). This
             dialog is opened from FilterLibraryWindow's "+ Add Custom
             Filter" tile, so it should look identical rather than pulling
             in a third separate copy's worth of drift. -->
        <SolidColorBrush x:Key="CanvasBrush" Color="#17181A" />
        <SolidColorBrush x:Key="InkBrush" Color="#F2F2F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9A9C9F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4FBFAE" />
        <SolidColorBrush x:Key="LineBrush" Color="#2C2E31" />
        <SolidColorBrush x:Key="FieldBrush" Color="#1F2023" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0C0D" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <StackPanel>
            <TextBlock Text="Add Custom Filter" FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,20" />

            <TextBlock Text="Name" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" />

            <TextBlock Text=".CUBE file" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,6" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BrowseButton" Content="Browse..." Click="BrowseButton_Click" />
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="FileCheckIcon" Text="&#x2713;" FontFamily="Segoe UI" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0" Visibility="Collapsed" />
                    <TextBlock x:Name="SelectedFileText" Text="No file selected." FontFamily="Segoe UI" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="FileDetailText" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource MutedBrush}"
                       Margin="0,6,0,0" Visibility="Collapsed" />

            <Border x:Name="ErrorBanner" Background="#1FE5484D" BorderBrush="#66E5484D" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" FontFamily="Segoe UI" FontSize="12" Foreground="#E5484D" TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="PreviewLabel" Text="Live Preview" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       Margin="0,20,0,8" Visibility="Collapsed" />
            <Grid x:Name="PreviewGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Image x:Name="BeforeImage" Height="70" Stretch="UniformToFill" />
                    <TextBlock Text="Before" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Image x:Name="AfterImage" Height="70" Stretch="UniformToFill" />
                    <TextBlock Text="After" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText" FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       Margin="0,14,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button x:Name="AddButton" Content="Add Filter" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="AddButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
