<Window x:Class="Photobooth.UI.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a color"
        Width="260" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}">
    <StackPanel Margin="16">
        <!-- Saturation/Value square: base layer is the pure hue color, a
             white-to-transparent horizontal gradient washes out saturation
             toward the left, and a transparent-to-black vertical gradient
             darkens value toward the bottom - the standard three-layer
             trick for an SV picker without hand-rolled pixel rendering. -->
        <Grid x:Name="SvArea" Width="200" Height="200" ClipToBounds="True" Cursor="Cross"
              MouseLeftButtonDown="SvArea_MouseLeftButtonDown"
              MouseMove="SvArea_MouseMove"
              MouseLeftButtonUp="SvArea_MouseLeftButtonUp">
            <Rectangle x:Name="SvHueLayer" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="SvCursor" Width="12" Height="12" Stroke="White" StrokeThickness="2" />
            </Canvas>
        </Grid>

        <Grid x:Name="HueBar" Width="200" Height="18" Margin="0,12,0,0" Cursor="Hand"
              MouseLeftButtonDown="HueBar_MouseLeftButtonDown"
              MouseMove="HueBar_MouseMove"
              MouseLeftButtonUp="HueBar_MouseLeftButtonUp">
            <Rectangle RadiusX="4" RadiusY="4">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF0000" Offset="0" />
                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                        <GradientStop Color="#FFFF0000" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Canvas IsHitTestVisible="False">
                <Rectangle x:Name="HueCursor" Width="4" Height="18" Fill="White" Stroke="Black" StrokeThickness="1" />
            </Canvas>
        </Grid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Border x:Name="PreviewSwatch" CornerRadius="5" />
            </Border>
            <TextBox x:Name="HexBox" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                     FontSize="16" Padding="6,4" TextChanged="HexBox_TextChanged" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Padding="14,7" Margin="0,0,8,0" Click="CancelButton_Click" IsCancel="True" />
            <Button Content="OK" Padding="14,7" Click="OkButton_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
