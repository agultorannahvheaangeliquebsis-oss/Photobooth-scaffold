<Window x:Class="Photobooth.UI.PrintTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Print Template"
        Background="{DynamicResource CanvasBrush}"
        WindowStartupLocation="CenterOwner"
        Width="900"
        Height="640">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkPalette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="EditorSectionHeader" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Margin" Value="0,16,0,6" />
            </Style>
            <Style x:Key="EditorLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Margin" Value="0,4,0,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="PRINT TEMPLATE EDITOR"
                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

        <!-- PreviewImage and ElementsCanvas share the same size/position, so
             a click's Canvas coordinate maps 1:1 to a pixel in the rendered
             preview: no extra scaling math needed to translate between them. -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="PreviewHost">
                <Image x:Name="PreviewImage" Stretch="Fill" />
                <Canvas x:Name="ElementsCanvas" Background="Transparent" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="Add element" Style="{StaticResource EditorSectionHeader}" Margin="0,0,0,6" />
            <WrapPanel>
                <Button x:Name="AddTextButton" Content="+ Text" Padding="10,6" Margin="0,0,8,6" Click="AddTextButton_Click" />
                <Button x:Name="AddLogoButton" Content="+ Logo" Padding="10,6" Margin="0,0,8,6" Click="AddLogoButton_Click" />
                <Button x:Name="AddImageButton" Content="+ Image" Padding="10,6" Margin="0,0,8,6" Click="AddImageButton_Click" />
                <Button x:Name="AddRectangleButton" Content="+ Rectangle" Padding="10,6" Margin="0,0,8,6" Click="AddRectangleButton_Click" />
                <Button x:Name="AddEllipseButton" Content="+ Ellipse" Padding="10,6" Margin="0,0,8,6" Click="AddEllipseButton_Click" />
                <Button x:Name="AddQrCodeButton" Content="+ QR Code" Padding="10,6" Margin="0,0,8,6" Click="AddQrCodeButton_Click" />
                <Button x:Name="AddSessionDataButton" Content="+ Session Data" Padding="10,6" Margin="0,0,8,6" Click="AddSessionDataButton_Click" />
                <Button x:Name="AddPhotoSlotButton" Content="+ Photo Slot" Padding="10,6" Margin="0,0,8,6" Click="AddPhotoSlotButton_Click" />
            </WrapPanel>

            <TextBlock Text="Layers" Style="{StaticResource EditorSectionHeader}" />
            <ListBox x:Name="LayerListBox" Height="90" SelectionChanged="LayerListBox_SelectionChanged" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="MoveLayerUpButton" Content="Move up" Padding="8,4" Margin="0,0,8,0" IsEnabled="False" Click="MoveLayerUpButton_Click" />
                <Button x:Name="MoveLayerDownButton" Content="Move down" Padding="8,4" IsEnabled="False" Click="MoveLayerDownButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="BringToFrontButton" Content="Bring to front" Padding="8,4" Margin="0,0,8,0" IsEnabled="False" Click="BringToFrontButton_Click" />
                <Button x:Name="SendToBackButton" Content="Send to back" Padding="8,4" IsEnabled="False" Click="SendToBackButton_Click" />
            </StackPanel>

            <TextBlock Text="Align to canvas" Style="{StaticResource EditorSectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AlignLeftButton" Content="Left" Padding="8,4" Margin="0,0,8,0" IsEnabled="False" Click="AlignLeftButton_Click" />
                <Button x:Name="AlignCenterHButton" Content="Center" Padding="8,4" Margin="0,0,8,0" IsEnabled="False" Click="AlignCenterHButton_Click" />
                <Button x:Name="AlignRightButton" Content="Right" Padding="8,4" IsEnabled="False" Click="AlignRightButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button x:Name="AlignTopButton" Content="Top" Padding="8,4" Margin="0,0,8,0" IsEnabled="False" Click="AlignTopButton_Click" />
                <Button x:Name="AlignCenterVButton" Content="Middle" Padding="8,4" Margin="0,0,8,0" IsEnabled="False" Click="AlignCenterVButton_Click" />
                <Button x:Name="AlignBottomButton" Content="Bottom" Padding="8,4" IsEnabled="False" Click="AlignBottomButton_Click" />
            </StackPanel>

            <TextBlock Text="Selected element" Style="{StaticResource EditorSectionHeader}" />
            <TextBlock x:Name="NoSelectionText" Text="Tap an element on the preview to edit it." Style="{StaticResource EditorLabel}"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

            <StackPanel x:Name="PositionSizePanel" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="X (px)" Style="{StaticResource EditorLabel}" />
                        <TextBox x:Name="ElementXBox" TextChanged="ElementXBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Y (px)" Style="{StaticResource EditorLabel}" />
                        <TextBox x:Name="ElementYBox" TextChanged="ElementYBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Width (px)" Style="{StaticResource EditorLabel}" />
                        <TextBox x:Name="ElementWidthBox" TextChanged="ElementWidthBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                        <TextBlock Text="Height (px)" Style="{StaticResource EditorLabel}" />
                        <TextBox x:Name="ElementHeightBox" TextChanged="ElementHeightBox_TextChanged" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="TextPropertiesPanel" Visibility="Collapsed">
                <TextBlock Text="Text" Style="{StaticResource EditorLabel}" />
                <TextBox x:Name="ElementTextBox" TextChanged="ElementTextBox_TextChanged" />

                <TextBlock Text="Font size" Style="{StaticResource EditorLabel}" />
                <Slider x:Name="FontSizeSlider" Minimum="0.02" Maximum="0.15" ValueChanged="FontSizeSlider_ValueChanged" />

                <CheckBox x:Name="BoldCheckBox" Content="Bold" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" Click="BoldCheckBox_Click" />

                <TextBlock Text="Color (hex)" Style="{StaticResource EditorLabel}" />
                <TextBox x:Name="ElementColorBox" TextChanged="ElementColorBox_TextChanged" />
            </StackPanel>

            <StackPanel x:Name="LogoPropertiesPanel" Visibility="Collapsed">
                <TextBlock x:Name="ImageKindLabel" Text="Logo image" Style="{StaticResource EditorLabel}" />
                <Button x:Name="ChangeLogoImageButton" Content="Browse..." Padding="8,4" HorizontalAlignment="Left" Click="ChangeLogoImageButton_Click" />
            </StackPanel>

            <StackPanel x:Name="ShapePropertiesPanel" Visibility="Collapsed">
                <TextBlock Text="Fill color (hex)" Style="{StaticResource EditorLabel}" />
                <TextBox x:Name="ShapeColorBox" TextChanged="ShapeColorBox_TextChanged" />
            </StackPanel>

            <StackPanel x:Name="QrCodePropertiesPanel" Visibility="Collapsed">
                <TextBlock Text="Renders the guest's own photo download link once their photo has uploaded. Blank if printing happens before the upload finishes."
                           Style="{StaticResource EditorLabel}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel x:Name="SessionDataPropertiesPanel" Visibility="Collapsed">
                <TextBlock Text="Field" Style="{StaticResource EditorLabel}" />
                <ComboBox x:Name="SessionDataFieldCombo" SelectionChanged="SessionDataFieldCombo_SelectionChanged">
                    <ComboBoxItem Content="Event Name" Tag="EventName" />
                    <ComboBoxItem Content="Date" Tag="Date" />
                    <ComboBoxItem Content="Time" Tag="Time" />
                </ComboBox>
            </StackPanel>

            <StackPanel x:Name="PhotoSlotPropertiesPanel" Visibility="Collapsed">
                <TextBlock x:Name="PhotoSlotIndexText" Style="{StaticResource EditorLabel}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Button x:Name="DeleteSelectedButton" Content="Delete selected" Padding="10,6" Margin="0,16,0,0"
                    HorizontalAlignment="Left" IsEnabled="False" Click="DeleteSelectedButton_Click" />

            <TextBlock x:Name="EditorStatusText" Style="{StaticResource EditorLabel}" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Save" Padding="16,8" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
