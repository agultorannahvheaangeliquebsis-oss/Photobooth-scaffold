<Window x:Class="Photobooth.UI.PrintTemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Print Template"
        Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterOwner"
        Width="900"
        Height="640">
    <Window.Resources>
        <Style x:Key="EditorSectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="PRINT TEMPLATE EDITOR"
                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12" />

        <!-- PreviewImage and ElementsCanvas share the same size/position, so
             a click's Canvas coordinate maps 1:1 to a pixel in the rendered
             preview: no extra scaling math needed to translate between them. -->
        <Border Grid.Row="1" Grid.Column="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid x:Name="PreviewHost">
                <Image x:Name="PreviewImage" Stretch="Fill" />
                <Canvas x:Name="ElementsCanvas" Background="Transparent" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="Add element" Style="{StaticResource EditorSectionHeader}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddTextButton" Content="+ Text" Padding="10,6" Margin="0,0,8,0" Click="AddTextButton_Click" />
                <Button x:Name="AddLogoButton" Content="+ Logo" Padding="10,6" Click="AddLogoButton_Click" />
            </StackPanel>

            <TextBlock Text="Selected element" Style="{StaticResource EditorSectionHeader}" />
            <TextBlock x:Name="NoSelectionText" Text="Tap an element on the preview to edit it." Style="{StaticResource EditorLabel}"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />

            <StackPanel x:Name="TextPropertiesPanel" Visibility="Collapsed">
                <TextBlock Text="Text" Style="{StaticResource EditorLabel}" />
                <TextBox x:Name="ElementTextBox" TextChanged="ElementTextBox_TextChanged" />

                <TextBlock Text="Font size" Style="{StaticResource EditorLabel}" />
                <Slider x:Name="FontSizeSlider" Minimum="0.02" Maximum="0.15" ValueChanged="FontSizeSlider_ValueChanged" />

                <CheckBox x:Name="BoldCheckBox" Content="Bold" Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" Click="BoldCheckBox_Click" />

                <TextBlock Text="Color (hex)" Style="{StaticResource EditorLabel}" />
                <TextBox x:Name="ElementColorBox" TextChanged="ElementColorBox_TextChanged" />
            </StackPanel>

            <StackPanel x:Name="LogoPropertiesPanel" Visibility="Collapsed">
                <TextBlock Text="Logo image" Style="{StaticResource EditorLabel}" />
                <Button x:Name="ChangeLogoImageButton" Content="Browse..." Padding="8,4" HorizontalAlignment="Left" Click="ChangeLogoImageButton_Click" />
            </StackPanel>

            <Button x:Name="DeleteSelectedButton" Content="Delete selected" Padding="10,6" Margin="0,16,0,0"
                    HorizontalAlignment="Left" IsEnabled="False" Click="DeleteSelectedButton_Click" />

            <TextBlock x:Name="EditorStatusText" Style="{StaticResource EditorLabel}" Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" Margin="0,16,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Padding="16,8" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Save" Padding="16,8" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
