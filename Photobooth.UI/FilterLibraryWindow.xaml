<Window x:Class="Photobooth.UI.FilterLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filters" Background="{StaticResource CanvasBrush}"
        WindowStartupLocation="CenterOwner"
        Width="960" Height="680" MinWidth="760" MinHeight="520">
    <Window.Resources>
        <!-- Same locally-scoped dark palette AdminWindow/EventLauncherWindow
             already established (see EventLauncherWindow's own Window.Resources
             comment), opened from AdminWindow's Effects & Stickers Configure
             button, so it gets the identical look rather than pulling in
             DarkPalette.xaml's separate (smaller) copy. -->
        <SolidColorBrush x:Key="CanvasBrush" Color="#17181A" />
        <SolidColorBrush x:Key="InkBrush" Color="#F2F2F0" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9A9C9F" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4FBFAE" />
        <SolidColorBrush x:Key="LineBrush" Color="#2C2E31" />
        <SolidColorBrush x:Key="FieldBrush" Color="#1F2023" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0C0D" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Filters" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="Select the filters you want to enable. Previews are rendered against a sample image, not dslrBooth's own test photo."
                           FontFamily="Segoe UI" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RegeneratePreviewsButton" Content="Regenerate previews" Margin="0,0,8,0" Click="RegeneratePreviewsButton_Click" />
                <Button x:Name="SaveButton" Content="Save Settings" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>

        <!-- ================= Filter tile grid ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="TilesPanel" />
        </ScrollViewer>

        <!-- ================= Status ================= -->
        <TextBlock Grid.Row="2" x:Name="StatusText" FontFamily="Segoe UI" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
